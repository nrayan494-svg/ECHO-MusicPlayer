<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="480.0" prefWidth="370.0" style="-fx-background-color: #100b18;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.LikedSongsController">

    <top>
        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 15 20 10 20;">
            <Label style="-fx-text-fill: #d8b4fe; -fx-font-size: 28px; -fx-font-weight: bold;" text="LIKED SONGS" />
            <Label fx:id="queueInfoLabel" style="-fx-text-fill: #d8b4fe; -fx-font-size: 12px;" textAlignment="CENTER" wrapText="true" />
        </VBox>
    </top>

    <center>
        <ListView fx:id="songsList" style="-fx-background-color: #20152b;">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></ListView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15;">
            <Button onAction="#onBack" prefHeight="40.0" prefWidth="90.0" style="-fx-background-color: #073d04; -fx-background-radius: 10; -fx-text-fill: #eeeeee; -fx-font-weight: bold;" text="BACK" />
            <Button onAction="#onPlaySelected" prefHeight="40.0" prefWidth="90.0" style="-fx-background-color: #073d04; -fx-background-radius: 10; -fx-text-fill: #eeeeee; -fx-font-weight: bold;" text="PLAY" />
            <Button onAction="#onRemoveFront" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: #073d04; -fx-background-radius: 10; -fx-text-fill: #eeeeee; -fx-font-weight: bold;" text="REMOVE FRONT" />
        </HBox>
    </bottom>

</BorderPane>
