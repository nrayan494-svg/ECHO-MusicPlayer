<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="480.0" prefWidth="370.0" style="-fx-background-color: #100b18;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AddSongController">

    <top>
        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 15 20 5 20;">
            <Label prefHeight="98.0" prefWidth="148.0" style="-fx-text-fill: #d8b4fe; -fx-font-size: 28px; -fx-font-weight: bold;" text="ADD SONG" />
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 5 25 5 25;">
            <TextField fx:id="titleField" prefHeight="38.0" promptText="Song title" style="-fx-background-color: #20152b; -fx-background-radius: 10; -fx-text-fill: #e9d5ff; -fx-prompt-text-fill: #7c6a94;" />
            <TextField fx:id="artistField" onAction="#onAdd" prefHeight="38.0" promptText="Artist" style="-fx-background-color: #20152b; -fx-background-radius: 10; -fx-text-fill: #e9d5ff; -fx-prompt-text-fill: #7c6a94;" />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button onAction="#onChooseAudio" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #073d04; -fx-background-radius: 10; -fx-text-fill: #eeeeee; -fx-font-weight: bold;" text="CHOOSE MP3" />
                <Label fx:id="audioLabel" maxWidth="175.0" prefWidth="175.0" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px;" text="No file chosen" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button onAction="#onChooseCover" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #073d04; -fx-background-radius: 10; -fx-text-fill: #eeeeee; -fx-font-weight: bold;" text="CHOOSE COVER" />
                <Label fx:id="coverLabel" maxWidth="175.0" prefWidth="175.0" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px;" text="No file chosen" />
            </HBox>

            <Button onAction="#onAdd" prefHeight="42.0" prefWidth="320.0" style="-fx-background-color: #073d04; -fx-background-radius: 10; -fx-text-fill: #eeeeee; -fx-font-weight: bold;" text="ADD TO LIBRARY" />
            <Label fx:id="statusLabel" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;" wrapText="true" />
            <Label fx:id="stackInfoLabel" style="-fx-text-fill: #d8b4fe; -fx-font-size: 12px;" wrapText="true" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 12;">
            <Button onAction="#onBack" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #073d04; -fx-background-radius: 10; -fx-text-fill: #eeeeee; -fx-font-weight: bold;" text="BACK" />
        </HBox>
    </bottom>

</BorderPane>
